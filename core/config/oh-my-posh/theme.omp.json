{
    "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
    "blocks": [
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "leading_diamond": "\ue0b6",
                    "template": " {{ if .Env.SSH_CONNECTION }}{{ .UserName }}@{{ .HostName }}{{ else }}󰣇{{ end }} ",
                    "foreground": "#F8F8F2",
                    "background": "#6272A4",
                    "type": "os",
                    "style": "diamond"
                },
                {
                    "powerline_symbol": "\ue0b4",
                    "template": "  \uf413 {{ .Path }} ",
                    "foreground": "#F8F8F2",
                    "background": "#BD93F9",
                    "type": "path",
                    "style": "powerline",
                    "options": {
                        "folder_separator_icon": "/",
                        "hide_root_location": true,
                        "max_depth": 1,
                        "style": "agnoster_short"
                    }
                },
                {
                    "powerline_symbol": "\ue0b4",
                    "template": " \ue725 ({{ .UpstreamIcon }} {{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}) ",
                    "foreground": "#F8F8F2",
                    "background": "#FF79C6",
                    "type": "git",
                    "style": "powerline",
                    "options": {
                        "branch_icon": "",
                        "fetch_status": false,
                        "fetch_upstream_icon": true
                    }
                },
                {
                    "powerline_symbol": "\ue0b4",
                    "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
                    "foreground": "#F8F8F2",
                    "background": "#8BE9FD",
                    "type": "node",
                    "style": "powerline"
                },
                {
                    "powerline_symbol": "\ue0b4",
                    "foreground": "#F8F8F2",
                    "background": "#FFB86C",
                    "type": "python",
                    "style": "powerline",
                    "options": {
                        "prefix": " \ue235 "
                    }
                }
            ]
        },
        {
            "type": "prompt",
            "alignment": "left",
            "segments": [
                {
                    "template": " ~ ",
                    "foreground": "#F8F8F2",
                    "type": "status",
                    "style": "plain",
					"options": {
						"always_enabled": true
					}
                }
            ],
            "newline": true
        }
    ],
    "version": 3,
    "final_space": true
}
