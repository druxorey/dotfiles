#!/usr/bin/env bash

declare -r FORMAT_SUCCESS="\e[1;32m[SUCCESS]\e[0m"
declare -r FORMAT_WARNING="\e[1;33m[WARNING]\e[0m"
declare -r FORMAT_FAILURE="\e[1;31m[FAILURE]\e[0m"

declare -r DOTFILES_URL="https://github.com/druxorey/dotfiles.git"
declare    DOTFILES_DIR="/tmp/drxdots"

declare -ra BASE_KERNELS=(
	"linux"
	"linux-lts"
	"linux-zen"
	"linux-hardened"
)

declare -ra CACHY_KERNELS=(
	"linux-cachyos"
	"linux-cachyos-lts"
	"linux-cachyos-bore"
	"linux-cachyos-hardened"
	"linux-cachyos-server"
)

declare -rA KERNEL_DESCRIPTIONS=(
	["linux"]="Vanilla Arch kernel, latest stable release"
	["linux-lts"]="Long-term support: slower updates, maximum stability"
	["linux-zen"]="Zen patchset: tuned for desktop responsiveness"
	["linux-hardened"]="Security-focused build with extra hardening"
	["linux-cachyos"]="CachyOS default: scheduler and performance tuning"
	["linux-cachyos-lts"]="CachyOS-optimised long-term support kernel"
	["linux-cachyos-bore"]="BORE scheduler: low latency and interactivity"
	["linux-cachyos-hardened"]="CachyOS build with security hardening"
	["linux-cachyos-server"]="Throughput-oriented kernel tuned for servers"
)

declare -rA FLAVOUR_DESCRIPTIONS=(
	["core"]="Terminal only (servers, VMs without GUI)"
	["minimal"]="Terminal + Lightweight graphical essentials"
	["bspwm"]="BSPWM tiling window manager (X11)"
	["kde"]="KDE Plasma desktop"
	["mangowm"]="MangoWM window manager"
	["cinnamon"]="Cinnamon desktop"
)

declare INSTALL_FLAVOUR=""
declare -a INSTALL_KERNELS=()
declare -i INSTALL_CACHY_REPOS=0
declare -a NAS_NAMES=()
declare -a NAS_SERVERS=()
declare -a NAS_USERS=()
declare -a NAS_PASSWORDS=()
declare GIT_NAME=""
declare GIT_EMAIL=""
declare GIT_SIGNING_KEY=""
declare -i GIT_GENERATE_SSH=0
declare -i SUDO_KEEPALIVE_PID=0
declare -i BACKUP_REPO_EXTERNAL=0
declare -i INSTALL_COMPLETED=0

function help() {
	local -r HELP_BOLD="\e[1;34m"
	local -r HELP_RESET="\e[0m"

	echo -e "${HELP_BOLD}USAGE:${HELP_RESET} ${0##*/} [COMMAND] [OPTIONS]

${HELP_BOLD}COMMANDS:${HELP_RESET}
  (none)               Starts the interactive installation wizard.
  install <FLAVOUR>    Installs system completely without prompts (core, minimal or specific flavour).
  backup  [OPTIONS]    Backs up active dotfiles configuration from your system to the repository.

${HELP_BOLD}FLAVOURS:${HELP_RESET} core, minimal, bspwm, kde, mangowm, etc.

${HELP_BOLD}BACKUP OPTIONS:${HELP_RESET}
  -d                   Show changes without modifying repository files (dry-run).
  -f FLAVOUR           Force specific flavour.

${HELP_BOLD}OPTIONS:${HELP_RESET}
  -h, --help           Show this help screen."
	exit 0
}


function ensureDependencies() {
	if [ $# -eq 0 ]; then
		printf "Error: No packages provided.\n" >&2
		return 1
	fi

	local -ra targetPackages=("$@")
	pacman -Qi "${targetPackages[@]}" >/dev/null 2>&1 && return 0

	printf "Installing missing dependencies...\n"

	sudo pacman -S --needed --noconfirm "${targetPackages[@]}" || {
		printf "%b Failed to install dependencies.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}

	printf "%b Dependencies installed successfully.\n" "$FORMAT_SUCCESS"
	exit 1
}


function ensureBackupRepository() {
	local -r scriptDirectory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

	if [[ -d $scriptDirectory/cmd && -d $scriptDirectory/core ]]; then
		DOTFILES_DIR="$scriptDirectory"
		return 0
	fi

	local repositoryName="${DOTFILES_URL##*/}"
	repositoryName="${repositoryName%.git}"
	local -r cloneDirectory="$PWD/$repositoryName"

	if [[ -e $cloneDirectory ]]; then
		if [[ ! -d $cloneDirectory/cmd || ! -d $cloneDirectory/core ]]; then
			printf "%b '%s' already exists and is not a dotfiles repository.\n" "$FORMAT_FAILURE" "$cloneDirectory" >&2
			exit 1
		fi
		printf "Not running inside the dotfiles repository. Using existing clone: %s\n" "$cloneDirectory"
	else
		printf "Not running inside the dotfiles repository. Cloning to %s...\n" "$cloneDirectory"
		git clone --quiet "$DOTFILES_URL" "$cloneDirectory" || {
			printf "%b Failed to clone dotfiles repository.\n" "$FORMAT_FAILURE" >&2
			exit 1
		}
	fi

	cd "$cloneDirectory" || exit 1
	DOTFILES_DIR="$cloneDirectory"
	BACKUP_REPO_EXTERNAL=1
}


function ensureSudo() {
	if ((EUID == 0)); then
		printf "%b Do not run this script directly as root. Run as a regular user with sudo permissions.\n" "$FORMAT_FAILURE" >&2
		exit 1
	fi

	sudo -v || {
		printf "%b Sudo privileges are required.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}

	(
		while kill -0 "$$" 2>/dev/null; do
			sudo -n true
			sleep 60
		done
	) >/dev/null 2>&1 &
	SUDO_KEEPALIVE_PID=$!
}


function updateSystem() {
	printf "Updating the system...\n"
	sudo pacman -Syu --noconfirm || {
		printf "%b Failed to update the system.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}
}


function ensureInstallRepository() {
	rm -rf "$DOTFILES_DIR" || {
		printf "%b Failed to remove previous clone at %s.\n" "$FORMAT_FAILURE" "$DOTFILES_DIR" >&2
		exit 1
	}
	printf "Cloning dotfiles repository to %s...\n" "$DOTFILES_DIR"
	git clone --quiet --depth 1 "$DOTFILES_URL" "$DOTFILES_DIR" || {
		printf "%b Failed to clone dotfiles repository.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}
}


function isCachyOs() {
	[[ -f /etc/os-release ]] || return 1
	[[ $(. /etc/os-release && printf '%s' "${ID:-}") == cachyos ]]
}

# Flavours are cumulative: core -> minimal -> requested flavour (later ones override earlier ones)
function resolveFlavours() {
	local -r flavour="$1"
	local -n outRef="$2"

	outRef=("core")
	[[ $flavour == core ]] && return 0
	outRef+=("flavours/minimal")
	[[ $flavour == minimal ]] && return 0
	outRef+=("flavours/$flavour")
	return 0
}


function dialogRun() {
	dialog --backtitle "drxdots installer" --stdout "$@"
}


function showMessage() {
	dialogRun --msgbox "$1" 0 0

	return 0
}

# Returns 0 for yes, 1 for no and 2 when the dialog was closed with ESC
function askYesNo() {
	local -i status=0

	dialogRun --yesno "\n$1" 0 0 || status=$?
	((status == 255)) && return 2

	return $status
}


function askMenu() {
	local -r text="$1"
	local -n resultRef="$2"
	shift 2

	resultRef=$(dialogRun --menu "$text" 0 0 5 "$@") || return 1

	return 0
}

# Keeps asking until the answer matches the regular expression (or the user cancels)
function askValidatedInput() {
	local -r text="$1"
	local currentValue="$2"
	local -n resultRef="$3"
	local -r pattern="$4"
	local -r errorMessage="$5"

	while true; do
		currentValue=$(dialogRun --inputbox "$text" 0 0 "$currentValue") || return 1
		if [[ $currentValue =~ $pattern ]]; then
			resultRef="$currentValue"
			return 0
		fi
		showMessage "$errorMessage"
	done
}


function askPassword() {
	local -r text="$1"
	local -n resultRef="$2"
	local firstEntry secondEntry

	while true; do
		firstEntry=$(dialogRun --insecure --passwordbox "$text" 0 0) || return 1
		if [[ -z $firstEntry ]]; then
			showMessage "The password cannot be empty."
			continue
		fi

		secondEntry=$(dialogRun --insecure --passwordbox "Repeat the password to confirm:" 0 0) || return 1
		if [[ $firstEntry == "$secondEntry" ]]; then
			resultRef="$firstEntry"
			return 0
		fi
		showMessage "The passwords do not match. Try again."
	done
}


function wizardCachyRepos() {
	isCachyOs && return 0

	askYesNo "Do you want to add the optimized CachyOS repositories? They provide optimized packages and extra kernels. This also replaces pacman with the CachyOS fork."
	case $? in
		0) INSTALL_CACHY_REPOS=1 ;;
		1) INSTALL_CACHY_REPOS=0 ;;
		*) return 1 ;;
	esac

	return 0
}


function wizardKernels() {
	local -a kernelNames=("${BASE_KERNELS[@]}")
	if isCachyOs || ((INSTALL_CACHY_REPOS)); then
		kernelNames+=("${CACHY_KERNELS[@]}")
	fi

	local -a items=()
	local kernel
	for kernel in "${kernelNames[@]}"; do
		items+=("$kernel" "${KERNEL_DESCRIPTIONS[$kernel]}" "off")
	done

	local selection
	selection=$(dialogRun --title "Select additional kernels to install (optional)" --separate-output --checklist "\nTheir headers are installed as well." 0 0 9 "${items[@]}") || return 1

	INSTALL_KERNELS=()
	while IFS= read -r kernel; do
		if [[ -n $kernel ]]; then
			INSTALL_KERNELS+=("$kernel")
		fi
	done <<< "$selection"

	return 0
}


function wizardFlavour() {
	local -a items=(
		"core" "${FLAVOUR_DESCRIPTIONS[core]}"
		"minimal" "${FLAVOUR_DESCRIPTIONS[minimal]}"
	)

	local flavourDir flavourName
	for flavourDir in "$DOTFILES_DIR"/flavours/*/; do
		flavourName="${flavourDir%/}"
		flavourName="${flavourName##*/}"
		[[ $flavourName == minimal ]] && continue
		[[ -f ${flavourDir}${flavourName}-install.sh ]] || continue
		items+=("$flavourName" "${FLAVOUR_DESCRIPTIONS[$flavourName]:-Custom flavour}")
	done

	askMenu "Select the flavour to install." INSTALL_FLAVOUR "${items[@]}"
}


function isNasNameTaken() {
	local -r name="$1"
	local existingName

	for existingName in "${NAS_NAMES[@]}"; do
		if [[ $existingName == "$name" ]]; then
			return 0
		fi
	done

	return 1
}


function wizardNasAdd() {
	local name="" server="//" user="" password=""

	# Shares usually live on the same server, so the last username is offered as a default
	if ((${#NAS_USERS[@]} > 0)); then
		user="${NAS_USERS[-1]}"
	fi

	while true; do
		askValidatedInput "Mount point name (it will be mounted at /mnt/<name>):" "$name" name \
			'^[A-Za-z0-9][A-Za-z0-9._-]*$' "Use only letters, numbers, dots, dashes and underscores." || return 1
		isNasNameTaken "$name" || break
		showMessage "There is already a share named '$name' in the list."
	done

	askValidatedInput "SMB share address (//SERVER/SHARE):" "$server" server \
		'^//[^/[:space:]]+/[^[:space:]]+$' "Use the format //SERVER/SHARE, without spaces." || return 1
	askValidatedInput "SMB username:" "$user" user \
		'^[^[:space:]]+$' "The username cannot be empty or contain spaces." || return 1
	askPassword "SMB password:" password || return 1

	NAS_NAMES+=("$name")
	NAS_SERVERS+=("$server")
	NAS_USERS+=("$user")
	NAS_PASSWORDS+=("$password")

	return 0
}


function wizardNasRemove() {
	local -r name="$1"
	local -i index

	askYesNo "Remove the share '$name' from the list?"
	case $? in
		0) ;;
		1) return 0 ;;
		*) return 1 ;;
	esac

	for index in "${!NAS_NAMES[@]}"; do
		if [[ ${NAS_NAMES[index]} == "$name" ]]; then
			NAS_NAMES=("${NAS_NAMES[@]:0:index}" "${NAS_NAMES[@]:index+1}")
			NAS_SERVERS=("${NAS_SERVERS[@]:0:index}" "${NAS_SERVERS[@]:index+1}")
			NAS_USERS=("${NAS_USERS[@]:0:index}" "${NAS_USERS[@]:index+1}")
			NAS_PASSWORDS=("${NAS_PASSWORDS[@]:0:index}" "${NAS_PASSWORDS[@]:index+1}")
			break
		fi
	done

	return 0
}


function wizardNas() {
	askYesNo "Do you want to configure SMB/NAS shares in /etc/fstab?"
	case $? in
		0) ;;
		1) return 0 ;;
		*) return 1 ;;
	esac

	local choice
	local -a items=()
	local -i index

	while true; do
		items=("+add" "Add a new share" "+done" "Finish")
		for index in "${!NAS_NAMES[@]}"; do
			items+=("${NAS_NAMES[index]}" "${NAS_SERVERS[index]} (user: ${NAS_USERS[index]}) - select to remove")
		done

		askMenu "Shares to configure: ${#NAS_NAMES[@]}\nAdd as many as you need, then choose '+done'." choice "${items[@]}" || return 1

		case $choice in
			"+add") wizardNasAdd || return 1 ;;
			"+done") return 0 ;;
			*) wizardNasRemove "$choice" || return 1 ;;
		esac
	done
}


function wizardGit() {
	askYesNo "Do you want to configure your Git identity and SSH key?"
	case $? in
		0) ;;
		1) return 0 ;;
		*) return 1 ;;
	esac

	askValidatedInput "Git user name:" "" GIT_NAME \
		'^[^[:space:]].*$' "The name cannot be empty." || return 1
	askValidatedInput "Git email:" "" GIT_EMAIL \
		'^[^@[:space:]]+@[^@[:space:]]+\.[^@[:space:]]+$' "Enter a valid email address." || return 1
	askValidatedInput "Signing key ID (optional, leave empty to skip):" "" GIT_SIGNING_KEY \
		'^[A-Za-z0-9]*$' "The key ID can only contain letters and numbers." || return 1

	askYesNo "Generate an ed25519 SSH key (only if you do not have one yet)?"
	case $? in
		0) GIT_GENERATE_SSH=1 ;;
		1) GIT_GENERATE_SSH=0 ;;
		*) return 1 ;;
	esac

	return 0
}


function wizardConfirm() {
	local -a flavourDirs=()
	resolveFlavours "$INSTALL_FLAVOUR" flavourDirs

	local flavourChain="" flavourDir
	for flavourDir in "${flavourDirs[@]}"; do
		flavourChain+="${flavourChain:+ + }${flavourDir##*/}"
	done

	local summary="Flavour: $INSTALL_FLAVOUR ($flavourChain)\n"

	if ((INSTALL_CACHY_REPOS)); then
		summary+="CachyOS repositories: will be added\n"
	fi

	if ((${#INSTALL_KERNELS[@]} > 0)); then
		summary+="Extra kernels: ${INSTALL_KERNELS[*]}\n"
	else
		summary+="Extra kernels: none\n"
	fi

	if ((${#NAS_NAMES[@]} > 0)); then
		local -i index
		for index in "${!NAS_NAMES[@]}"; do
			summary+="NAS share: ${NAS_SERVERS[index]} -> /mnt/${NAS_NAMES[index]} (user: ${NAS_USERS[index]})\n"
		done
	else
		summary+="NAS shares: not configured\n"
	fi

	if [[ -n $GIT_NAME ]]; then
		local sshAction="skip"
		if ((GIT_GENERATE_SSH)); then
			sshAction="generate if missing"
		fi

		summary+="Git identity: $GIT_NAME <$GIT_EMAIL>\n"
		summary+="Signing key: ${GIT_SIGNING_KEY:-none}\n"
		summary+="SSH key: $sshAction\n"
	else
		summary+="Git identity: not configured\n"
	fi

	askYesNo "${summary}\nProceed with the installation?" || return 1

	return 0
}

# Fails before touching the system if a selected option needs a tool the repository does not have
function validateInstallRepository() {
	local -a flavourDirs=()
	resolveFlavours "$INSTALL_FLAVOUR" flavourDirs

	local flavourDir script
	for flavourDir in "${flavourDirs[@]}"; do
		script="$DOTFILES_DIR/$flavourDir/${flavourDir##*/}-install.sh"
		if [[ ! -f $script ]]; then
			printf "%b Install script not found: '%s' (does flavour '%s' exist?)\n" "$FORMAT_FAILURE" "$script" "$INSTALL_FLAVOUR" >&2
			exit 1
		fi
	done

	local -a requiredTools=("ensure-yay.sh" "install-packages.sh")
	((INSTALL_CACHY_REPOS)) && requiredTools+=("add-cachy-repos.sh")
	((${#NAS_NAMES[@]} > 0)) && requiredTools+=("configure-fstab-nas.sh")
	[[ -n $GIT_NAME ]] && requiredTools+=("configure-git-ssh.sh")

	local -i missing=0
	local tool
	for tool in "${requiredTools[@]}"; do
		if [[ ! -f $DOTFILES_DIR/cmd/$tool ]]; then
			printf "%b Required tool not found in the repository: cmd/%s\n" "$FORMAT_FAILURE" "$tool" >&2
			missing=1
		fi
	done

	((missing)) && exit 1
}


function installSystemTools() {
	if ((INSTALL_CACHY_REPOS)); then
		bash "$DOTFILES_DIR/cmd/add-cachy-repos.sh" || {
			printf "%b Failed to add CachyOS repositories.\n" "$FORMAT_FAILURE" >&2
			exit 1
		}
		updateSystem
	fi

	bash "$DOTFILES_DIR/cmd/ensure-yay.sh" || {
		printf "%b Failed to ensure yay AUR helper installation.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}
}


function installFlavours() {
	local -a flavourDirs=()
	resolveFlavours "$INSTALL_FLAVOUR" flavourDirs

	local flavourDir
	for flavourDir in "${flavourDirs[@]}"; do
		printf "\n>>> Installing flavour: %s\n" "${flavourDir##*/}"
		bash "$DOTFILES_DIR/$flavourDir/${flavourDir##*/}-install.sh" || {
			printf "%b Installation of flavour '%s' failed.\n" "$FORMAT_FAILURE" "${flavourDir##*/}" >&2
			exit 1
		}
	done
}


function installKernels() {
	((${#INSTALL_KERNELS[@]} > 0)) || return 0

	local kernelsFile
	kernelsFile=$(mktemp --suffix=.packages "$DOTFILES_DIR/kernels.XXXXXX") || exit 1

	local kernel
	for kernel in "${INSTALL_KERNELS[@]}"; do
		printf "%s\n%s-headers\n" "$kernel" "$kernel" >> "$kernelsFile"
	done

	printf "\n>>> Installing kernels: %s\n" "${INSTALL_KERNELS[*]}"
	bash "$DOTFILES_DIR/cmd/install-packages.sh" "$kernelsFile" || {
		printf "%b Kernel installation failed.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}
}


function configureNas() {
	local -i index
	for index in "${!NAS_NAMES[@]}"; do
		printf "\n>>> Configuring NAS share: %s\n" "${NAS_NAMES[index]}"
		NAS_PASSWORD="${NAS_PASSWORDS[index]}" bash "$DOTFILES_DIR/cmd/configure-fstab-nas.sh" \
			-n "${NAS_NAMES[index]}" -s "${NAS_SERVERS[index]}" -u "${NAS_USERS[index]}" || {
			printf "%b NAS configuration of '%s' failed.\n" "$FORMAT_FAILURE" "${NAS_NAMES[index]}" >&2
			exit 1
		}
	done
}


function configureGit() {
	[[ -n $GIT_NAME ]] || return 0

	local -a gitArgs=(-n "$GIT_NAME" -e "$GIT_EMAIL")
	if [[ -n $GIT_SIGNING_KEY ]]; then
		gitArgs+=(-k "$GIT_SIGNING_KEY")
	fi
	if ((GIT_GENERATE_SSH)); then
		gitArgs+=(-s)
	fi

	printf "\n>>> Configuring Git identity and SSH\n"
	bash "$DOTFILES_DIR/cmd/configure-git-ssh.sh" "${gitArgs[@]}" || {
		printf "%b Git and SSH configuration failed.\n" "$FORMAT_FAILURE" >&2
		exit 1
	}
}


function finalize() {
	if ((SUDO_KEEPALIVE_PID > 0)); then
		kill "$SUDO_KEEPALIVE_PID" 2>/dev/null
	fi

	rm -rf "$DOTFILES_DIR"

	if ((INSTALL_COMPLETED)); then
		printf "\n%b Installation of '%s' completed. A reboot is recommended.\n" "$FORMAT_SUCCESS" "$INSTALL_FLAVOUR"
	fi
}


function runBackup() {
	ensureDependencies "rsync"
	ensureBackupRepository

	local -i status=0
	bash "$DOTFILES_DIR/cmd/backup-dotfiles.sh" "$@" || status=$?

	if ((BACKUP_REPO_EXTERNAL && status == 0)); then
		printf "\nThe backup repository is located at '%s'. Review, commit and push your changes from there.\n" "$DOTFILES_DIR"
	fi

	return $status
}


function runHeadlessInstall() {
	INSTALL_FLAVOUR="${1:-}"

	if [[ -z $INSTALL_FLAVOUR ]]; then
		printf "%b Flavour must be specified for installation (e.g. '%s install bspwm').\n" "$FORMAT_FAILURE" "${0##*/}" >&2
		exit 1
	fi

	if (($# > 1)) || [[ ! $INSTALL_FLAVOUR =~ ^[a-z0-9][a-z0-9_-]*$ ]]; then
		printf "%b Invalid flavour or arguments. Try '%s -h' for more information.\n" "$FORMAT_FAILURE" "${0##*/}" >&2
		exit 1
	fi

	trap finalize EXIT

	ensureSudo
	updateSystem
	ensureDependencies "git"
	ensureInstallRepository
	validateInstallRepository

	installSystemTools
	installFlavours

	INSTALL_COMPLETED=1
}


function runWizardInstall() {
	if [[ ! -t 0 || ! -t 1 ]]; then
		printf "%b The interactive wizard needs a terminal. Use '%s install <FLAVOUR>' instead.\n" "$FORMAT_FAILURE" "${0##*/}" >&2
		exit 1
	fi

	trap finalize EXIT

	ensureSudo
	updateSystem
	ensureDependencies "git" "dialog"
	ensureInstallRepository

	wizardCachyRepos || exit 1
	wizardKernels    || exit 1
	wizardFlavour    || exit 1
	wizardNas        || exit 1
	wizardGit        || exit 1
	wizardConfirm    || exit 1

	validateInstallRepository

	installSystemTools
	installFlavours
	installKernels
	configureNas
	configureGit

	INSTALL_COMPLETED=1
}


function main() {
	local -r command="${1:-}"
	case $command in
		-h|--help) help ;;
		backup)  shift; runBackup "$@";;
		install) shift; runHeadlessInstall "$@" ;;
		"")      runWizardInstall ;;
		*)       printf "%b Unknown command: '%s'. Try '%s -h' for more information.\n" "$FORMAT_FAILURE" "$command" "${0##*/}" >&2 && exit 1 ;;
	esac
}

main "$@"
