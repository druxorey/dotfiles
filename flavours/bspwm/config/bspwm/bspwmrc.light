#!/bin/sh
#! ========================================================================== !#
#!
#!                 ██████╗ ███████╗██████╗ ██╗    ██╗███╗   ███╗
#!                 ██╔══██╗██╔════╝██╔══██╗██║    ██║████╗ ████║
#!                 ██████╔╝███████╗██████╔╝██║ █╗ ██║██╔████╔██║
#!                 ██╔══██╗╚════██║██╔═══╝ ██║███╗██║██║╚██╔╝██║
#!                 ██████╔╝███████║██║     ╚███╔███╔╝██║ ╚═╝ ██║
#!                 ╚═════╝ ╚══════╝╚═╝      ╚══╝╚══╝ ╚═╝     ╚═╝
#!
#!                         https://github.com/druxorey
#!
#! ========================================================================== !#

#* =========================== startup application ========================== *#

polybar &
dunst &
picom &
sxhkd &

#* ================================== bspc ================================== *#

bspc monitor eDP-1 -d     
bspc monitor HDMI-1 -d   

bspc config pointer_modifier mod4
bspc config pointer_action1 move
bspc config pointer_action2 resize_side
bspc config pointer_action2 resize_corner

bspc config border_width 3
bspc config window_gap 10

bspc config split_ratio 0.50
bspc config borderless_monocle false
bspc config gapless_monocle false

bspc config normal_border_color "#EDE9DA"
bspc config active_border_color "#EDE9DA"
bspc config focused_border_color "#CB3A2A"
bspc config presel_feedback_color "#CB3A2A"

bspc rule -a Blueman-manager state=floating center=true
bspc rule -a protonvpn-app state=floating center=true
bspc rule -a "Proton Pass" state=floating center=true
bspc rule -a Qalculate-gtk state=floating center=true
bspc rule -a simple-scan state=floating center=true
bspc rule -a Gloobus-preview state=floating
bspc rule -a Screenkey manage=off
bspc rule -a Flameshot state=floating sticky=on manage=off
bspc rule -a floating_drxpkg state=floating center=on rectangle=1000x900+0+0
bspc rule -a floating_cheatsheets state=floating center=on rectangle=1300x900+0+0
bspc rule -a floating_obsidian state=floating center=on rectangle=1000x1050+0+0

wmname LG3D

#* ================================== init ================================== *#

if xrandr | grep -q "HDMI-1 connected"; then
	xset -dpms
	xset s off
else
	xset +dpms
	xset s 600
fi

feh --bg-fill "$HOME/.local/share/wallpaper_actual" &
sudo ln -sf /etc/tlp.d/01-normal.conf /etc/tlp.conf
sudo tlp start
sudo smbios-battery-ctl --set-charging-mode=custom --set-custom-charge-interval 50 80 &
systemctl --user enable --now clipmenud &
xidlehook --not-when-fullscreen --not-when-audio --timer 900 \
		  "sudo ln -sf '/etc/tlp.d/02-powersave.conf' '/etc/tlp.conf' && sudo tlp start" \
		  "sudo ln -sf '/etc/tlp.d/01-normal.conf' '/etc/tlp.conf' && sudo tlp start" &
blueman-applet &
