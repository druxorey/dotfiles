#!/usr/bin/env bash

declare -r FORMAT_SUCCESS="\e[1;32m[SUCCESS]\e[0m"
declare -r FORMAT_FAILURE="\e[1;31m[FAILURE]\e[0m"

declare -r TEMPLATES_PATH="$HOME/.local/share/crater"
declare -rA EXTENSION_MAP=(
	['bash']='sh'
	['c']='c'
	['cpp']='cpp'
	['c++']='cpp'
	['go']='go'
	['golang']='go'
	['html']='html'
	['java']='java'
	['latex']='tex'
	['lua']='lua'
	['py']='py'
	['python']='py'
	['rs']='rs'
	['rust']='rs'
	['sh']='sh'
	['shell']='sh'
	['tex']='tex'
)

function help() {
	local -r BOLD="\e[1;34m"
	local -r RESET="\e[0m"

	echo -e "${BOLD}USAGE:${RESET} ${0##*/} [OPTIONS] <FILE_TYPE> [OUTPUT_NAME]

${BOLD}DESCRIPTION:${RESET}
  Creates template-based files and project structures.

${BOLD}ARGUMENTS:${RESET}
  FILE_TYPE    Language identifier (e.g., bash, c, cpp, go, python, rust, latex).
  OUTPUT_NAME  Destination file or directory name (default: 'default').

${BOLD}OPTIONS:${RESET}
  -i INDEX     Select template non-interactively by index.
  -l           List all supported categories and available templates.
  -p           Print template content to stdout instead of copying.
  -h           Display this help message."
	exit 0
}


function listTemplates() {
	if [[ ! -d $TEMPLATES_PATH ]]; then
		printf "%b Templates directory '%s' not found.\n" "$FORMAT_FAILURE" "$TEMPLATES_PATH" >&2
		return 1
	fi

	local categoryDir
	local -a items=()
	local -i count=0

	for categoryDir in "$TEMPLATES_PATH"/*; do
		[[ ! -d $categoryDir ]] && continue

		local ext="${categoryDir##*/}"
		printf "\e[1;32m[%s]\e[0m\n" "$ext"

		items=()
		for item in "$categoryDir"/*; do
			[[ -e $item ]] && items+=("$item")
		done

		if ((${#items[@]} == 0)); then
			printf "  (No templates found)\n"
		else
			for ((i = 0; i < ${#items[@]}; i++)); do
				local name="${items[i]##*/}"
				if [[ -d ${items[i]} ]]; then
					printf "  [%d] \e[1;34m%s/\e[0m\n" "$i" "$name"
				else
					printf "  [%d] %s\n" "$i" "$name"
				fi
			done
		fi
		printf "\n"
		((count++))
	done

	if ((count == 0)); then
		printf "No template categories found in '%s'.\n" "$TEMPLATES_PATH"
	fi

	return 0
}


function printTemplate() {
	local srcPath="$1"
	if [[ -d $srcPath ]]; then
		printf "%b Cannot print directory template '%s' to standard output.\n" "$FORMAT_FAILURE" "${srcPath##*/}" >&2
		return 1
	fi
	cat "$srcPath"
	return 0
}


function copyTemplate() {
	local srcPath="$1"
	local destName="$2"
	local ext="$3"
	local destPath

	if [[ -d $srcPath ]]; then
		destPath="$destName"
	else
		if [[ $destName == *."$ext" ]]; then
			destPath="$destName"
		else
			destPath="$destName.$ext"
		fi
	fi

	if [[ -e $destPath ]]; then
		printf "%b Target '%s' already exists. Aborting to avoid overwrite.\n" "$FORMAT_FAILURE" "$destPath" >&2
		return 1
	fi

	cp -rp "$srcPath" "$destPath" || {
		printf "%b Failed to copy template to '%s'.\n" "$FORMAT_FAILURE" "$destPath" >&2
		return 1
	}

	printf "%b Created '%s' from template '%s'.\n" "$FORMAT_SUCCESS" "$destPath" "${srcPath##*/}"
	return 0
}


function main() {
	local optIndex=''
	local flagPrint=false

	while getopts "i:lph" opt; do
		case $opt in
			i) optIndex="$OPTARG" ;;
			l) listTemplates ; return $? ;;
			p) flagPrint=true ;;
			h) help ;;
			*) printf "%b Try '%s -h' for more information.\n" "$FORMAT_FAILURE" "${0##*/}" >&2 && return 1 ;;
		esac
	done
	shift $((OPTIND - 1))

	local fileType="$1"
	local outputName="${2:-default}"

	[[ -z $fileType ]] && printf "%b File type is required.\n" "$FORMAT_FAILURE" >&2 && return 1
	[[ ! -d $TEMPLATES_PATH ]] && printf "%b Templates directory '%s' not found.\n" "$FORMAT_FAILURE" "$TEMPLATES_PATH" >&2 && return 1

	local ext="${EXTENSION_MAP[$fileType]:-}"
	if [[ -z $ext ]]; then
		printf "%b Unsupported file type '%s'.\n" "$FORMAT_FAILURE" "$fileType" >&2
		return 1
	fi

	local templateDir="$TEMPLATES_PATH/$ext"
	if [[ ! -d $templateDir ]]; then
		printf "%b Template category directory '%s' does not exist.\n" "$FORMAT_FAILURE" "$templateDir" >&2
		return 1
	fi

	local -a templates=()
	for item in "$templateDir"/*; do
		[[ -e $item ]] && templates+=("$item")
	done

	local -i totalTemplates=${#templates[@]}
	if ((totalTemplates == 0)); then
		printf "%b No templates found in '%s'.\n" "$FORMAT_FAILURE" "$templateDir" >&2
		return 1
	fi

	local -i selectedIndex=-1

	if [[ -n $optIndex ]]; then
		if [[ ! $optIndex =~ ^[0-9]+$ ]] || ((optIndex < 0 || optIndex >= totalTemplates)); then
			printf "%b Invalid index '%s'. Available range: 0 to %d.\n" "$FORMAT_FAILURE" "$optIndex" $((totalTemplates - 1)) >&2
			return 1
		fi
		selectedIndex=$optIndex
	elif ((totalTemplates == 1)); then
		selectedIndex=0
	else
		printf "Available templates for '%s':\n" "$fileType"
		for i in "${!templates[@]}"; do
			local name="${templates[i]##*/}"
			if [[ -d ${templates[i]} ]]; then
				printf "  [%d] \e[1;34m%s/\e[0m\n" "$i" "$name"
			else
				printf "  [%d] %s\n" "$i" "$name"
			fi
		done

		printf "Enter template index [0-%d]: " $((totalTemplates - 1))
		local userInput
		read -r userInput

		if [[ ! $userInput =~ ^[0-9]+$ ]] || ((userInput < 0 || userInput >= totalTemplates)); then
			printf "%b Invalid selection '%s'.\n" "$FORMAT_FAILURE" "$userInput" >&2
			return 1
		fi
		selectedIndex=$userInput
	fi

	if [[ $flagPrint == true ]]; then
		printTemplate "${templates[selectedIndex]}"
	else
		copyTemplate "${templates[selectedIndex]}" "$outputName" "$ext"
	fi
}

main "$@"
