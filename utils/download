#!/usr/bin/env bash

declare -r FORMAT_SUCCESS="\e[1;32m[SUCCESS]\e[0m"
declare -r FORMAT_FAILURE="\e[1;31m[FAILURE]\e[0m"

function downloadFromLinks() {
	local links=("$@")
	
	if [ ${#links[@]} -eq 0 ]; then
		printf "%b No links provided to download.\n" "$FORMAT_FAILURE"
		return 1
	fi

	printf "Starting download of %d files...\n" "${#links[@]}"

	local -i index=1
	for link in "${links[@]}"; do
		wget -q --show-progress "$link"
		if [ $? -ne 0 ]; then
			printf "%b Failed to download file %d\n" "$FORMAT_FAILURE" "$index"
		else
			((index++))
		fi
	done
	printf "%b Successfully downloaded %d files\n" "$FORMAT_SUCCESS" "$index"
}


function exportLinksToFile() {
	local filepath="$1"
	shift
	local links=("$@")

	if [ ${#links[@]} -eq 0 ]; then
		printf "%b No links provided to export.\n" "$FORMAT_FAILURE"
		return 1
	fi

	printf "%s\n" "${links[@]}" > "$filepath"
	printf "%b Successfully exported %d links to '%s'\n" "$FORMAT_SUCCESS" "${#links[@]}" "$filepath"
}


function main() {
	local exportFile=""

	while getopts "hf:" opt; do
		case $opt in
			h) printf "\e[1;34mUSAGE:\e[0m %s [-f filename.txt]\n" "${0##*/}" && return 0 ;;
			f) exportFile="$OPTARG" ;;
			*) printf "%b Try '%s -h' for more information.\n" "$FORMAT_FAILURE" "${0##*/}" >&2 && return 1 ;;
		esac
	done

	if ! command -v xclip &> /dev/null; then
		printf "%b 'xclip' is required to monitor clipboard.\n" "$FORMAT_FAILURE"
		return 1
	fi

	local lastClipboard=""
	local currentClipboard=""
	local links=()

	if [ -n "$exportFile" ]; then
		echo "Monitoring clipboard. Exporting to '$exportFile'. Press ENTER to save or Ctrl+C to exit."
	else
		echo "Monitoring clipboard. Copy links to add them. Press ENTER to start downloads or Ctrl+C to exit."
	fi

	while true; do
		if read -t 0.1 -r; then
			if [ -n "$exportFile" ]; then
				exportLinksToFile "$exportFile" "${links[@]}"
			else
				downloadFromLinks "${links[@]}"
			fi
			return 0
		fi

		currentClipboard=$(xclip -selection clipboard -o 2>/dev/null)
		
		if [[ "$currentClipboard" != "$lastClipboard" ]] && [[ "$currentClipboard" =~ ^https?:// ]]; then
			links+=("${currentClipboard}")
			lastClipboard="${currentClipboard}"
			printf " ⮞ \e[1;34mAdded\e[0m: %s\n" "${currentClipboard}"
		fi
	done
}

main "$@"
