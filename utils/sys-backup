#!/usr/bin/env bash

# This script securely imports its sensitive credentials and environment variables
# from an external configuration file located at the user's config folder.
#
# The configuration file must contain:
#   - IP_SERVER (string)
#   - LOG_FILE (string)
#   - SMB_USERS (associative array)
#   - SMB_PASSWORDS (associative array)
#   - BACKUPS (indexed array)
#
# Backup task format: "credential_profile|backup_type|local_path|remote_path"
# Supported types:
#   - push: Mirror local to remote. Files in remote missing locally are deleted.
#   - pull: Mirror remote to local. Files locally missing in remote are deleted.
#   - sync: Safe bidirectional merge. Updates newer files, NEVER deletes files.

declare -r FORMAT_SUCCESS="\e[1;32m[SUCCESS]\e[0m"
declare -r FORMAT_WARNING="\e[1;33m[WARNING]\e[0m"
declare -r FORMAT_FAILURE="\e[1;31m[FAILURE]\e[0m"

declare -g  IS_DRY_RUN="false"
declare -g  CONFIG_FILE="$HOME/.config/sys-backup.conf"
declare -gA OBSCURED_PASSWORDS

[[ -f $CONFIG_FILE ]] && source "$CONFIG_FILE"

function help() {
	local -r HELP_BOLD="\e[1;34m"
	local -r HELP_RESET="\e[0m"

	echo -e "${HELP_BOLD}USAGE:${HELP_RESET} $(basename "$0") [OPTIONS]

${HELP_BOLD}DESCRIPTION:${HELP_RESET}
  Backs up local directories to an SMB server, supporting one-way mirroring
  (push/pull) and safe non-destructive bidirectional synchronization.

${HELP_BOLD}OPTIONS:${HELP_RESET}
  -d  Dry-run simulation mode. Shows what would be copied without
      making real changes.
  -e  Opens the configuration file in the default terminal editor,
      creating it along with its parent directory if it does not exist.
  -h  Displays this help message."

	return 0
}


function loadConfiguration() {
	declare -gr LOCAL_USER=$(id -un)

	if [[ ! -f $CONFIG_FILE ]]; then
		printf "%b %s\n" "$FORMAT_FAILURE" "Configuration file not found at '$CONFIG_FILE'" >&2
		exit 1
	fi

	# Validate core configuration variables
	if [[ -z $LOCAL_USER ]] || [[ -z $IP_SERVER ]] || [[ -z $LOG_FILE ]]; then
		printf "%b %s\n" "$FORMAT_FAILURE" "Incomplete configuration in '$CONFIG_FILE'. Check IP_SERVER and LOG_FILE." >&2
		exit 1
	fi

	# Validate associative arrays for SMB credentials
	if ((${#SMB_USERS[@]} == 0)) || ((${#SMB_PASSWORDS[@]} == 0)); then
		printf "%b %s\n" "$FORMAT_FAILURE" "SMB_USERS or SMB_PASSWORDS are not defined or empty in '$CONFIG_FILE'." >&2
		exit 1
	fi

	# Validate backup tasks list
	if ((${#BACKUPS[@]} == 0)); then
		printf "%b %s\n" "$FORMAT_FAILURE" "No backup tasks defined in 'BACKUPS' array in '$CONFIG_FILE'." >&2
		exit 1
	fi
}


function obscurePasswords() {
	# rclone obscure command translates plain-text passwords into obscured format on-the-fly.
	# Using --config /dev/null silences the default config file notices.
	local key
	for key in "${!SMB_PASSWORDS[@]}"; do
		OBSCURED_PASSWORDS[$key]=$(rclone --config /dev/null obscure "${SMB_PASSWORDS[$key]}")
	done
}


function performBackup() {
	local credProfile="$1"
	local backupType="$2"
	local localPath="$3"
	local remotePath="$4"

	local -a rcloneOpts=("-v" "--stats=0")
	[[ $IS_DRY_RUN == "true" ]] && rcloneOpts+=("--dry-run")

	local user="${SMB_USERS[$credProfile]}"
	local pass="${OBSCURED_PASSWORDS[$credProfile]}"

	if [[ -z $user ]] || [[ -z $pass ]]; then
		printf "%b %s\n" "$FORMAT_FAILURE" "Credentials not found for profile '$credProfile' (Task: $localPath -> $remotePath)" >&2
		return 1
	fi

	local -i exitStatus=0

	if [[ $backupType == "push" ]]; then
		printf "%s\n" "Starting push mirror of '$localPath' to '$remotePath'..."

		# Mirror local to remote. Files on remote not present in local are deleted.
		rclone --config /dev/null sync "$localPath" :smb:"$remotePath" \
			--smb-host "$IP_SERVER" \
			--smb-user "$user" \
			--smb-pass "$pass" \
			"${rcloneOpts[@]}"
		exitStatus=$?

	elif [[ $backupType == "pull" ]]; then
		printf "%s\n" "Starting pull mirror of '$remotePath' to '$localPath'..."

		# Mirror remote to local. Files on local not present in remote are deleted.
		rclone --config /dev/null sync :smb:"$remotePath" "$localPath" \
			--smb-host "$IP_SERVER" \
			--smb-user "$user" \
			--smb-pass "$pass" \
			"${rcloneOpts[@]}"
		exitStatus=$?

	elif [[ $backupType == "sync" ]]; then
		printf "%s\n" "Starting safe bidirectional merge between '$localPath' and '$remotePath'..."

		# Non-destructive bidirectional sync:
		# Phase 1: Copy newer or missing files from local to remote (never deletes).
		printf "%s\n" "Phase 1/2: Copying local changes to remote..."
		rclone --config /dev/null copy "$localPath" :smb:"$remotePath" \
			--update \
			--smb-host "$IP_SERVER" \
			--smb-user "$user" \
			--smb-pass "$pass" \
			"${rcloneOpts[@]}"
		local -i statusPush=$?

		# Phase 2: Copy newer or missing files from remote to local (never deletes).
		printf "%s\n" "Phase 2/2: Copying remote changes to local..."
		rclone --config /dev/null copy :smb:"$remotePath" "$localPath" \
			--update \
			--smb-host "$IP_SERVER" \
			--smb-user "$user" \
			--smb-pass "$pass" \
			"${rcloneOpts[@]}"
		local -i statusPull=$?

		if ((statusPush != 0 || statusPull != 0)); then
			exitStatus=1
		else
			exitStatus=0
		fi

	else
		printf "%b %s\n" "$FORMAT_FAILURE" "Unsupported backup type '$backupType' (Task: $localPath -> $remotePath)" >&2
		return 1
	fi

	if ((exitStatus == 0)); then
		printf "%b %s\n" "$FORMAT_SUCCESS" "Task '$backupType' for '$localPath' completed successfully."
		return 0
	else
		printf "%b %s\n" "$FORMAT_WARNING" "There were issues or warnings during task '$backupType' for '$localPath'."
		return 1
	fi
}


function main() {
	while getopts "deh" opt; do
		case $opt in
		d) IS_DRY_RUN="true" ;;
		e)
			mkdir -p "$(dirname "$CONFIG_FILE")"
			[[ -f $CONFIG_FILE ]] || touch "$CONFIG_FILE"
			"${VISUAL:-${EDITOR:-vi}}" "$CONFIG_FILE"
			exit 0
			;;
		h) help && exit 0 ;;
		*) printf "%b Try '%s -h' for help.\n" "$FORMAT_FAILURE" "$(basename "$0")" >&2 && exit 1 ;;
		esac
	done
	shift $((OPTIND - 1))

	loadConfiguration

	if ! command -v rclone &> /dev/null; then
		printf "%b %s\n" "$FORMAT_FAILURE" "The 'rclone' utility is required but not installed." >&2
		exit 1
	fi

	if ! timeout 3 bash -c "true > /dev/tcp/$IP_SERVER/445" &> /dev/null; then
		printf "%b %s\n" "$FORMAT_FAILURE" "Connection to $IP_SERVER on port 445 (SMB) failed." >&2
		exit 1
	fi

	mkdir -p "$(dirname "$LOG_FILE")"
	exec > >(tee -i -a "$LOG_FILE") 2>&1

	printf "╒════════════════════════════════════════════════════════════════════════╕\n"
	printf "│                  Backup started: %s                   │\n" "$(date '+%Y-%m-%d %H:%M:%S')"
	[[ $IS_DRY_RUN == "true" ]] && printf "│        SIMULATION MODE ACTIVE (No real changes will be applied)        │\n"
	printf "╘════════════════════════════════════════════════════════════════════════╛\n"

	obscurePasswords

	local -i exitCode=0
	local backupEntry credentialProfile backupType localPath remotePath
	for backupEntry in "${BACKUPS[@]}"; do
		# Parse entry: profile|type|local_path|remote_path
		IFS='|' read -r credentialProfile backupType localPath remotePath <<< "$backupEntry"

		if [[ -z $credentialProfile ]] || [[ -z $backupType ]] || [[ -z $localPath ]] || [[ -z $remotePath ]]; then
			printf "%b %s\n" "$FORMAT_FAILURE" "Invalid backup entry format: '$backupEntry'" >&2
			exitCode=1
			continue
		fi

		if ! performBackup "$credentialProfile" "$backupType" "$localPath" "$remotePath"; then
			exitCode=1
		fi
	done

	printf "╒════════════════════════════════════════════════════════════════════════╕\n"
	printf "│                 Backup completed: %s                  │\n" "$(date '+%Y-%m-%d %H:%M:%S')"
	printf "╘════════════════════════════════════════════════════════════════════════╛\n"

	return $exitCode
}

main "$@"
