#!/usr/bin/env python3

import hashlib
import json
import os
import re
import secrets
import sys
import unicodedata
import urllib.parse
import urllib.request
from pathlib import Path

FORMAT_SUCCESS = "\033[1;32m[SUCCESS]\033[0m"
FORMAT_WARNING = "\033[1;33m[WARNING]\033[0m"
FORMAT_FAILURE = "\033[1;31m[FAILURE]\033[0m"

NAVIDROME_URL = os.environ.get("NAVIDROME_URL")
NAVIDROME_USER = os.environ.get("NAVIDROME_USER")
NAVIDROME_PASS = os.environ.get("NAVIDROME_PASS")

LOCAL_MUSIC_DIR = Path.home() / "Music"
CMUS_PLAYLIST_DIR = Path.home() / ".config" / "cmus" / "playlists"
M3U_EXPORT_DIR = LOCAL_MUSIC_DIR / "Playlists"

FAVORITES_PLAYLIST_NAME = "Favoritos"

SERVER_PATH_PREFIXES = ["files/Guillermo/Música/", "Música/", "music/"]
AUDIO_EXTENSIONS = {".mp3", ".flac", ".m4a", ".ogg", ".opus", ".wav"}


def normalize(text: str) -> str:
    if not text:
        return ""
    text = (
        unicodedata.normalize("NFKD", str(text))
        .encode("ASCII", "ignore")
        .decode("utf-8")
    )
    text = text.lower()
    text = re.sub(r"[^a-z0-9]+", " ", text)
    return " ".join(text.split())


def getCoreTitle(title: str) -> str:
    core = re.split(r"[\(\[\-]\s*(feat|ft|with|prod)\b", title, flags=re.IGNORECASE)[0]
    return normalize(core)


def subsonicRequest(endpoint: str, params: dict) -> dict:
    salt = secrets.token_hex(6)
    token = hashlib.md5((str(NAVIDROME_PASS) + salt).encode("utf-8")).hexdigest()

    baseParams = {
        "u": NAVIDROME_USER,
        "t": token,
        "s": salt,
        "v": "1.16.1",
        "c": "cmus-sync",
        "f": "json",
    }
    baseParams.update(params)

    queryString = urllib.parse.urlencode(baseParams)
    url = f"{NAVIDROME_URL.rstrip('/')}/rest/{endpoint}?{queryString}"

    req = urllib.request.Request(url, headers={"User-Agent": "cmus-navidrome-sync/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=10) as response:
            data = json.loads(response.read().decode("utf-8"))
            subResp = data.get("subsonic-response", {})
            if subResp.get("status") != "ok":
                errorMsg = subResp.get("error", {}).get("message", "Unknown Error")
                raise RuntimeError(f"API Subsonic: {errorMsg}")
            return subResp
    except urllib.error.URLError as e:
        print(f"{FORMAT_FAILURE} Failed to connect to Navidrome: {e}", file=sys.stderr)
        sys.exit(1)


def buildLocalIndex() -> list[dict]:
    index = []
    for root, _, files in os.walk(LOCAL_MUSIC_DIR):
        for file in files:
            ext = os.path.splitext(file)[1].lower()
            if ext in AUDIO_EXTENSIONS:
                path = Path(root) / file
                index.append(
                    {
                        "path": path,
                        "norm_stem": normalize(path.stem),
                        "norm_path": normalize(str(path)),
                    }
                )
    return index


def resolveLocalPath(serverPath: str) -> Path:
    cleaned = serverPath.lstrip("/")
    for prefix in SERVER_PATH_PREFIXES:
        if cleaned.startswith(prefix):
            cleaned = cleaned[len(prefix) :].lstrip("/")
            break
    return LOCAL_MUSIC_DIR / cleaned


def findInIndex(entry: dict, fileIndex: list[dict]) -> Path | None:
    rawPath = entry.get("path", "")
    if rawPath:
        direct = resolveLocalPath(rawPath)
        if direct.is_file():
            return direct

    title = entry.get("title", "")
    artist = entry.get("artist", "")
    album = entry.get("album", "")
    track = entry.get("track")

    normalizedTitle = normalize(title)
    coreTitle = getCoreTitle(title)
    normalizedArtist = normalize(artist)
    normalizedAlbum = normalize(album)

    bestMatch = None
    bestScore = -1

    for item in fileIndex:
        stem = item["norm_stem"]
        full = item["norm_path"]
        score = 0

        if normalizedTitle and normalizedTitle == stem:
            score += 100
        elif normalizedTitle and normalizedTitle in stem:
            score += 80
        elif coreTitle and len(coreTitle) >= 3 and coreTitle in stem:
            score += 70
        elif stem and len(stem) >= 3 and stem in normalizedTitle:
            score += 60
        else:
            tWords = [w for w in normalizedTitle.split() if len(w) > 2]
            if tWords:
                matchedWords = sum(1 for w in tWords if w in stem)
                ratio = matchedWords / len(tWords)
                if ratio >= 0.7:
                    score += int(50 * ratio)

        if score == 0:
            continue

        if normalizedArtist and normalizedArtist in full:
            score += 40
        if normalizedAlbum and normalizedAlbum in full:
            score += 20

        if track is not None:
            try:
                trkPrefix = f"{int(track):02d}"
                if stem.startswith(trkPrefix) or f" {trkPrefix} " in f" {stem} ":
                    score += 15
            except ValueError:
                pass

        if score > bestScore:
            bestScore = score
            bestMatch = item["path"]

    return bestMatch if bestScore >= 60 else None


def writePlaylistFiles(name: str, tracks: list[str]) -> None:
    safeName = name.replace("/", "-").strip()

    cmusFile = CMUS_PLAYLIST_DIR / safeName
    with open(cmusFile, "w", encoding="utf-8") as f:
        for track in tracks:
            f.write(f"{track}\n")

    m3uFile = M3U_EXPORT_DIR / f"{safeName}.m3u"
    with open(m3uFile, "w", encoding="utf-8") as f:
        f.write("#EXTM3U\n")
        for track in tracks:
            f.write(f"{track}\n")


def processEntries(entries: list[dict], file_index: list[dict]) -> list[str]:
    localTracks = []
    for entry in entries:
        matched = findInIndex(entry, file_index)
        if matched:
            localTracks.append(str(matched))
        else:
            print(
                f"{FORMAT_WARNING} Not found on disk: {entry.get('title')}",
                file=sys.stderr,
            )
    return localTracks


def main():
    CMUS_PLAYLIST_DIR.mkdir(parents=True, exist_ok=True)
    M3U_EXPORT_DIR.mkdir(parents=True, exist_ok=True)

    print(f"Indexing audio files in {LOCAL_MUSIC_DIR}...")
    fileIndex = buildLocalIndex()
    print(f"{FORMAT_SUCCESS} {len(fileIndex)} local files indexed.")

    print("Querying playlists from Navidrome...")
    playlistsResp = subsonicRequest("getPlaylists", {})
    playlists = playlistsResp.get("playlists", {}).get("playlist", [])
    if isinstance(playlists, dict):
        playlists = [playlists]

    for playlist in playlists:
        playlistId = playlist.get("id")
        playlistName = playlist.get("name")
        detailResp = subsonicRequest("getPlaylist", {"id": playlistId})
        entries = detailResp.get("playlist", {}).get("entry", [])
        if isinstance(entries, dict):
            entries = [entries]

        localTracks = processEntries(entries, fileIndex)
        writePlaylistFiles(str(playlistName), localTracks)
        print(
            f"{FORMAT_SUCCESS} Playlist '{playlistName}': {len(localTracks)} tracks linked."
        )

    print("Querying starred tracks from Navidrome...")
    starredResp = subsonicRequest("getStarred2", {})
    starredData = starredResp.get("starred2", {}) or starredResp.get("starred", {})
    starredSongs = starredData.get("song", [])
    if isinstance(starredSongs, dict):
        starredSongs = [starredSongs]

    starredTracks = processEntries(starredSongs, fileIndex)
    writePlaylistFiles(FAVORITES_PLAYLIST_NAME, starredTracks)
    print(
        f"{FORMAT_SUCCESS} Playlist '{FAVORITES_PLAYLIST_NAME}': {len(starredTracks)} tracks linked."
    )


if __name__ == "__main__":
    main()
